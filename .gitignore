# ── 의존성 ──
/node_modules

# ── Next.js 빌드 산출물 (정적 export 결과는 out/) ──
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# ── 테스트 산출물 (Vitest·Playwright) ──
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# ── 비밀값: 환경변수 파일은 모두 무시하고 템플릿만 추적 (CLAUDE.md §1-8) ──
# .env, .env.local, .env.*.local, .env.development, .env.production, .env.test 등
.env*
!.env.example
*.pem

# ── 로그 ──
npm-debug.log*
*.log

# ── 개인 로컬 설정 ──
.claude/settings.local.json

# ── OS ──
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE ──
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# data/는 파이프라인 산출물로 커밋 대상이므로 무시하지 않는다 (CLAUDE.md §5).
