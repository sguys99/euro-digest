# 유로 다이제스트 환경변수 템플릿 (CLAUDE.md §10)
#
# 사용법
#   - 로컬: 이 파일을 .env.local로 복사해 값을 채운다 (cp .env.example .env.local).
#     .env.local은 .gitignore 대상이며 절대 커밋하지 않는다.
#   - Next.js(dev/build)는 .env.local을 자동으로 읽는다.
#   - scripts/*.ts는 --env-file로 읽는다 (예: tsx --env-file=.env.local scripts/collect.ts).
#   - CI/GitHub Actions: API 키 3종은 Actions Secrets로만 주입한다. 이 파일에 실제 값을 넣지 않는다.

# ── 비밀값 (값은 비워 둔다) ──
# Anthropic API 키 — 뉴스 요약·팀 한줄평·한국 선수 주간 총평 (LLM 호출은 scripts/lib/llm.ts에서만)
ANTHROPIC_API_KEY=
# football-data.org API 키 — 주 축구 데이터 소스 (분당 10회 제한)
FOOTBALL_DATA_API_KEY=
# API-Football API 키 — 보조 축구 데이터 소스 (하루 100회 제한, 일일 계획 ≤ 60회)
API_FOOTBALL_KEY=

# ── LLM ──
# 사용할 모델 — 상향은 사용자 승인 후에만 (CLAUDE.md §1-3)
LLM_MODEL=claude-haiku-5-5
# live = 실제 호출 / mock = fixtures/llm/ 응답 사용 (자동 테스트·CI는 mock)
LLM_MODE=live
# 일일 요약 상한 (건)
MAX_ITEMS_PER_RUN=45

# ── 비용 가드 (runs.json + runs-dev.json 합산 기준) ──
# 일일 LLM 예산 (USD) — 초과 예상 시 LLM 없이 원제목+링크로 게시
DAILY_BUDGET_USD=0.10
# 월간 LLM 예산 (USD)
MONTHLY_BUDGET_USD=3

# ── 사이트 ──
# 공개 사이트 origin (canonical·OG·RSS 절대 URL용)
SITE_URL=https://sguys99.github.io
# GitHub Pages 프로젝트 경로 — next.config.ts의 basePath. 빈 값이면 루트(/)로 빌드
BASE_PATH=/euro-digest

# ── 운영 ──
# 크롤러 User-Agent·삭제 요청 연락처
CONTACT_EMAIL=sguys99@gmail.com
