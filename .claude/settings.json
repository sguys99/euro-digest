{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/.env.*.local)",
      "Read(/.env.development)",
      "Read(/.env.production)",
      "Read(/.env.test)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Bash(cat *.env)",
      "Bash(cat *.env *)",
      "Bash(cat *.env.*local*)",
      "Bash(head *.env)",
      "Bash(head *.env *)",
      "Bash(head *.env.*local*)",
      "Bash(tail *.env)",
      "Bash(tail *.env *)",
      "Bash(tail *.env.*local*)",
      "Bash(grep *.env)",
      "Bash(grep *.env *)",
      "Bash(grep *.env.*local*)",
      "Bash(less *.env)",
      "Bash(less *.env *)",
      "Bash(less *.env.*local*)",
      "Bash(less *.env.development*)",
      "Bash(less *.env.production*)",
      "Bash(less *.env.test*)",
      "Bash(more *.env)",
      "Bash(more *.env *)",
      "Bash(more *.env.*local*)",
      "Bash(more *.env.development*)",
      "Bash(more *.env.production*)",
      "Bash(more *.env.test*)",
      "Bash(bat *.env)",
      "Bash(bat *.env *)",
      "Bash(bat *.env.*local*)",
      "Bash(bat *.env.development*)",
      "Bash(bat *.env.production*)",
      "Bash(bat *.env.test*)",
      "Bash(source *.env)",
      "Bash(source *.env *)",
      "Bash(source *.env.*local*)",
      "Bash(source *.env.development*)",
      "Bash(source *.env.production*)",
      "Bash(source *.env.test*)",
      "Bash(. *.env)",
      "Bash(. *.env *)",
      "Bash(. *.env.*local*)",
      "Bash(. *.env.development*)",
      "Bash(. *.env.production*)",
      "Bash(. *.env.test*)"
    ],
    "ask": [
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(gh variable delete *)",
      "Bash(gh variable remove *)",
      "Bash(gh workflow disable *)",
      "Bash(gh release delete *)",
      "Bash(npm publish *)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -fr*)",
      "Bash(rm -fR*)",
      "Bash(rm --recursive*)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "eli5@claude-community": true
  },
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  }
}
