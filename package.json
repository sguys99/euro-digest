{
  "name": "euro-digest",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "매일 아침 07:00, 유럽 축구 소식을 한국어 3줄로.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node --env-file-if-exists=.env.local --import tsx scripts/build-feeds.ts",
    "preview": "tsx scripts/serve-out.ts",
    "verify:deploy": "tsx scripts/verify-deploy.ts",
    "collect": "node --env-file-if-exists=.env.local --import tsx scripts/collect.ts",
    "summarize": "node --env-file-if-exists=.env.local --import tsx scripts/summarize.ts",
    "weekly": "node --env-file-if-exists=.env.local --import tsx scripts/weekly.ts",
    "ops-report": "node --env-file-if-exists=.env.local --import tsx scripts/ops-report.ts",
    "eval:prompt": "node --env-file-if-exists=.env.local --import tsx scripts/eval-prompt.ts",
    "validate": "node --env-file-if-exists=.env.local --import tsx scripts/validate.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:bundle": "node --env-file-if-exists=.env.local --import tsx scripts/check-bundle.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
